# Local PostgreSQL. On Railway set DATABASE_URL to a reference variable such as
# ${{Postgres.DATABASE_URL}} on the web and worker services.
DATABASE_URL=postgresql://postgres@localhost:5432/ourvalleys

# Optional Railway-only recovery override. Leave blank normally. When used, this
# must also be a protected reference to the PostgreSQL service, never a copied
# connection string committed to source control.
DATABASE_PRIVATE_URL=
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/ourvalleys_test

# A private random value of at least 32 characters. Never commit the real value.
BETTER_AUTH_SECRET=

# Local URLs. Railway deployments may omit these when RAILWAY_PUBLIC_DOMAIN is
# available; the application derives the canonical HTTPS origin safely.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RAILWAY_PUBLIC_DOMAIN=

# Release boundary. Development and private pilot remain noindex. Public release
# fails closed until the three independently verified readiness flags are true
# and transactional email plus media storage are configured. The retained
# read-only viewer is not privileged; owner and administrator demos must be gone.
OURVALLEYS_RELEASE_STAGE=development
# Resident reviews are deferred (docs/38). Leave false until the owner enables them.
OURVALLEYS_REVIEWS_ENABLED=false
PRIVILEGED_DEMOS_REMOVED=false
POLICIES_APPROVED=false
ADMIN_MFA_READY=false

# Optional transactional email. Uncomment only when configured. Postmark is
# preferred when both providers are set. POSTMARK_API_KEY is a Postmark Server
# API Token; EMAIL_FROM must be an address on a domain verified in Postmark.
# POSTMARK_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=OurValleys <hello@ourvalleys.co.uk>

# Optional. The one private platform administrator. After this account has
# registered and verified its email, the next deploy grants it the admin role.
# Admin actions still require two-step verification to be enrolled.
# ADMIN_EMAIL=

# Optional Cloudflare R2 business media. Uncomment only when configured.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

LOG_LEVEL=info